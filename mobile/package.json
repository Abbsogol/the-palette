  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "preview:home": "EXPO_PUBLIC_DESIGN_PREVIEW=1 expo start --go --port 8084",
    "start": "expo start",
    "start:connected": "EXPO_PUBLIC_DESIGN_PREVIEW=0 expo start --dev-client --port 8083",
    "build:connected:ios": "npx eas-cli@latest build --platform ios --profile beta-development",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm test",
    "doctor": "expo-doctor",
    "build:beta:ios": "npx eas-cli@latest build --platform ios --profile beta",
    "build:beta:android": "npx eas-cli@latest build --platform android --profile beta",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
