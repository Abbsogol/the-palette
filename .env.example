# Copy to .env.local. Fill with isolated development/staging values.
# Keep actual credentials out of Git. Never use production keys for tests.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# Optional: without this key, reminders do not send email.
RESEND_API_KEY=
