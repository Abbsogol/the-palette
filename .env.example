# Copy to .env.local. Fill with isolated development/staging values.
# Keep actual credentials out of Git. Never use production keys for tests.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRON_SECRET=

# Optional: without this key, reminders do not send email.
RESEND_API_KEY=

# Set isolated Stripe Price IDs for sandbox/staging subscriptions.
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO_CREATOR=

# Native mobile beta — isolated backend only. No production values here.
MOBILE_ENVIRONMENT=
MOBILE_SUPABASE_PROJECT_REF=
MOBILE_RETURN_SCHEMES=
REVENUECAT_ENVIRONMENT=SANDBOX
REVENUECAT_APP_IDS=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=

# Optional Google Calendar. Use a separate OAuth web client for calendar access.
# Keep disabled until migration 023, callback, consent, secrets and retry worker are verified.
GOOGLE_CALENDAR_ENABLED=false
NEXT_PUBLIC_GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# Base64-encoded random 32-byte AES key; server-only, preserve it across deploys.
GOOGLE_CALENDAR_TOKEN_KEY=
# Exact, comma-separated return URLs, e.g. laque-dev://calendar-connect,laque://calendar-connect
GOOGLE_CALENDAR_RETURN_URLS=

# Optional Pinterest pilot. Server-only; keep off until docs/mobile-beta/pinterest-activation.md gates pass.
PINTEREST_ENABLED=0
PINTEREST_SOURCE_APPROVED=0
PINTEREST_ZERO_SPEND_VERIFIED=0
PINTEREST_PILOT_USER_IDS=
PINTEREST_SOURCE=
PINTEREST_BOARD_ID=
PINTEREST_HALLOWEEN_BOARD_ID=
PINTEREST_PARTNER_APPROVED=0
PINTEREST_COUNTRY_CODE=AE
PINTEREST_ACCESS_TOKEN=
PINTEREST_TOKEN_EXPIRES_AT=
PINTEREST_SIGNING_SECRET=
PINTEREST_DAILY_LIMIT=100
PINTEREST_MINUTE_LIMIT=5
PINTEREST_USER_DAILY_LIMIT=10
PINTEREST_WEB_ORIGINS=

# Owner-only Pinterest OAuth. Configure server secrets and the exact beta callback.
# Keep shared display on the existing adapter until consent/boards/review gates pass.
PINTEREST_OAUTH_MODE=0
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
# Base64-encoded random 32-byte AES key. Preserve across deployments.
PINTEREST_TOKEN_KEY=

# Retire legacy web Lab purchases; subscriptions and tokens are purchased in app.
LAB_APP_ONLY_BILLING=1
